# Copy to .env for local testing. Never commit the real file.

# The deployed Chakra backend
CHAKRA_API_URL=https://chakra-v5-backend.onrender.com

# MUST be byte-identical to the Chakra backend SECRET_KEY
SECRET_KEY=

# Whose tasks this connector exposes
CHAKRA_USER_ID=dk
CHAKRA_DISPLAY_NAME=DK

# Static bearer token (used if Claude accepts a raw token)
MCP_ACCESS_TOKEN=

# Password DK types on the OAuth consent screen
MCP_LOGIN_PASSWORD=

# Signs OAuth codes/tokens issued by this service
MCP_SECRET=

# Public URL of THIS service once deployed
PUBLIC_URL=

TIMEZONE=America/Chicago
